{
  "name": "hello-along",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:com": "vite --host 127.0.0.1 --mode com",
    "build": "node scripts/build-markets.mjs",
    "verify:release-assets": "node scripts/verify-release-assets.mjs",
    "build:com": "node scripts/build-market.mjs com",
    "build:ru": "node scripts/build-market.mjs ru",
    "build:legacy": "node scripts/build-stages.mjs",
    "build:stage": "node scripts/write-stage-content.mjs",
    "build:stages": "node scripts/build-stages.mjs",
    "scan:leaks": "node scripts/stage-leakage-scan.mjs dist",
    "scan:stage-leaks": "node scripts/stage-leakage-scan.mjs artifacts/stages",
    "test:scheduler": "bash scripts/rehearse-scheduler.sh",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "serve:static": "node scripts/static-stage-server.mjs",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "test": "vitest run"
    ,"test:browser": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
